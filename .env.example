# v6 is a separate experimental browser assistant, not a verified direct booking API client.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Required when multiple recipients exist; private checkout statuses go only to the owner.
BOOKING_OWNER_CHAT_ID=

TICKET_URL=https://widget.afisha.yandex.ru/w/sessions/MTEwOTYzfDkwODE5MnwxNDk2OTE2MnwxNzk2NDgxMDAwMDAw?clientKey=5a2f3e1d-f923-4b55-8a34-636ba6dfe922&regionId=213
EXPECTED_EVENT_ID=908192
EXPECTED_DATE=2026-12-05
DISCOVERY_INTERVAL_SECONDS=600

# Engineering setting, NOT a Yandex-approved or ban-proof limit. Floor: 10 seconds.
CHECK_INTERVAL_SECONDS=10
POLL_JITTER_FRACTION=0.10
REQUEST_TIMEOUT_SECONDS=15

# Enable only after setup/capture and after you have checked the budget/UI.
AUTO_BOOKING=false
# Opt-in: prepare a NEW SBP payment; no cards, saved payment methods or bank confirmation.
AUTO_START_SBP=false
BOOKING_HEADLESS=false
BOOKING_SEATS=1
BOOKING_ADJACENT=true
# Exact full names, separated by commas; empty means all sectors within the budget.
BOOKING_SECTORS=
# Both are required for automation. RUB, inclusive of known fees, not kopеcks.
BOOKING_MAX_PRICE_RUB=
BOOKING_MAX_TOTAL_RUB=

# Fill locally. These values are not included in the distributed archive.
BUYER_FULL_NAME=
BUYER_EMAIL=
BUYER_PHONE=

# ===== VPS / Docker / noVNC settings =====
# 8 ASCII letters/numbers due to legacy VNC password compatibility.
# noVNC MUST be accessed over SSH tunnel or Tailscale Serve, not a public port.
VNC_PASSWORD=
# manual: GUI console, setup and capture; watch: watcher starts automatically at container launch.
START_MODE=manual
