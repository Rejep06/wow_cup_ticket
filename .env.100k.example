# WOW CUP max 2 seats per order, at least 1; different rows/sectors allowed.
# Copy into .env and set private values. DO NOT send .env to anyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
BOOKING_OWNER_CHAT_ID=

TICKET_URL=https://widget.afisha.yandex.ru/w/sessions/MTEwOTYzfDkwODE5MnwxNDk2OTE2MnwxNzk2NDgxMDAwMDAw?clientKey=5a2f3e1d-f923-4b55-8a34-636ba6dfe922&regionId=213
EXPECTED_EVENT_ID=908192
EXPECTED_DATE=2026-12-05
DISCOVERY_INTERVAL_SECONDS=600

CHECK_INTERVAL_SECONDS=10
POLL_JITTER_FRACTION=0.10
REQUEST_TIMEOUT_SECONDS=15

# 1 or 2 tickets (prefer 2 if compatible/within budget).
BOOKING_SEATS=2
BOOKING_MIN_SEATS=1
BOOKING_ADJACENT=false
# Blank = any sector.
BOOKING_SECTORS=
# Limits in rubles, INCLUDING seat fees known to the hallplan and checks of checkout total.
BOOKING_MAX_PRICE_RUB=100000
BOOKING_MAX_TOTAL_RUB=100000

# Checkout automation. Needs user profile, real widget UI and POST create payload verification.
AUTO_BOOKING=true
# Try to launch SBP payment UI. Never confirm bank transfer.
AUTO_START_SBP=true
BOOKING_HEADLESS=false

BUYER_FULL_NAME=
BUYER_EMAIL=
BUYER_PHONE=

# Exactly 8 ASCII letters/digits. noVNC is private over SSH / Tailscale ONLY.
VNC_PASSWORD=
# Begin with manual for browser sign-in/captcha. Set watch only after setup.
START_MODE=manual
